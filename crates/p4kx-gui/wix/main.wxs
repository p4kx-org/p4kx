<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="P4KX"
      Language="1033"
      Codepage="1252"
      Version="$(var.Version)"
      Manufacturer="P4KX contributors"
      UpgradeCode="090C8F25-8543-42F0-B40A-1514653149F9"
      Scope="perUser">
    <SummaryInformation Manufacturer="P4KX contributors" Description="P4KX $(var.Version)" />
    <MajorUpgrade
        AllowSameVersionUpgrades="yes"
        Schedule="afterInstallInitialize"
        DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <?include path-transport.wxi?>
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/p4kx-org/p4kx" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Icon Id="P4kx.ico" SourceFile="$(var.RepositoryFolder)\crates\p4kx-gui\assets\p4kx.ico" />
    <Property Id="ARPPRODUCTICON" Value="P4kx.ico" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserPrograms" Name="Programs">
        <Directory Id="APPLICATIONFOLDER" Name="P4KX">
          <Component Id="Application" Guid="$(var.ApplicationGuid)" Bitness="always64">
            <File Id="GuiExe" Name="p4kx-gui.exe" Source="$(var.BinaryFolder)\p4kx-gui.exe" />
            <File Id="CliExe" Name="p4kx.exe" Source="$(var.BinaryFolder)\p4kx.exe" />
            <File Id="McpExe" Name="p4kx-mcp.exe" Source="$(var.BinaryFolder)\p4kx-mcp.exe" />
            <File Id="DistributionIdentity" Name="p4kx-distribution.json" Source="$(var.BinaryFolder)\p4kx-distribution.json" />
            <File Id="WindowsRuntimeInventory" Name="windows-runtime.json" Source="$(var.BinaryFolder)\windows-runtime.json" />
            <File Id="MicrosoftRuntimeNotice" Name="MICROSOFT-REDISTRIBUTABLE-NOTICE.txt" Source="$(var.BinaryFolder)\MICROSOFT-REDISTRIBUTABLE-NOTICE.txt" />
            <File Id="MsiHelperInventory" Name="p4kx-msi-helper.json" Source="$(var.HelperFolder)\p4kx-msi-helper.json" />
            <File Id="MsiHelperNotice" Name="p4kx-msi-helper-NOTICE.txt" Source="$(var.HelperFolder)\p4kx-msi-helper-NOTICE.txt" />
            <File Id="MsiHelperSbom" Name="p4kx-msi-helper.cdx.json" Source="$(var.HelperFolder)\p4kx-msi-helper.cdx.json" />
            <File Id="Changelog" Name="CHANGELOG.md" Source="$(var.BinaryFolder)\CHANGELOG.md" />
            <File Id="LicenceMit" Name="LICENSE-MIT" Source="$(var.RepositoryFolder)\LICENSE-MIT" />
            <File Id="LicenceApache" Name="LICENSE-APACHE" Source="$(var.RepositoryFolder)\LICENSE-APACHE" />
            <File Id="LicenceMitMarkdown" Name="LICENSE-MIT.md" Source="$(var.RepositoryFolder)\LICENSE-MIT.md" />
            <File Id="LicenceApacheMarkdown" Name="LICENSE-APACHE.md" Source="$(var.RepositoryFolder)\LICENSE-APACHE.md" />
            <File Id="ThirdPartyNotices" Name="THIRD-PARTY-NOTICES.md" Source="$(var.RepositoryFolder)\THIRD-PARTY-NOTICES.md" />
            <RegistryValue
                Root="HKCU"
                Key="Software\P4KX"
                Name="Application"
                Type="integer"
                Value="1"
                KeyPath="yes" />
            <RemoveFolder Id="RemoveApplicationFolder" Directory="APPLICATIONFOLDER" On="uninstall" />
            <RemoveFolder Id="RemoveUserPrograms" Directory="UserPrograms" On="uninstall" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="$(var.ShortcutGuid)" Bitness="always64">
        <Shortcut
            Id="GuiShortcut"
            Name="P4KX"
            Description="Open, browse and extract Star Citizen Archives"
            Icon="P4kx.ico"
            Target="[APPLICATIONFOLDER]p4kx-gui.exe"
            WorkingDirectory="APPLICATIONFOLDER" />
        <RegistryValue
            Root="HKCU"
            Key="Software\P4KX"
            Name="StartMenuShortcut"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Complete" Title="P4KX" Level="1">
      <ComponentRef Id="Application" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="RuntimeLibraries" />
    </Feature>
  </Package>
</Wix>
