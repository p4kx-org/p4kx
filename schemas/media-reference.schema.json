{
  "$defs": {
    "Algorithm": {
      "description": "Integrity algorithm, without conflating CRC checks with cryptographic hashes.",
      "oneOf": [
        {
          "const": "sha256",
          "description": "SHA-256 cryptographic hash.",
          "type": "string"
        },
        {
          "const": "crc32",
          "description": "ZIP CRC-32 polynomial.",
          "type": "string"
        },
        {
          "const": "crc32c",
          "description": "Castagnoli CRC-32C polynomial.",
          "type": "string"
        }
      ]
    },
    "ByteScope": {
      "description": "Exact byte scope of a computed or declared integrity value.",
      "oneOf": [
        {
          "const": "root-archive-file",
          "description": "Every byte streamed from the root Archive file.",
          "type": "string"
        },
        {
          "const": "stored-entry-payload",
          "description": "Entry bytes before decryption and decompression.",
          "type": "string"
        },
        {
          "const": "decoded-entry-payload",
          "description": "Entry bytes after decryption and decompression.",
          "type": "string"
        },
        {
          "const": "artifact-file",
          "description": "Every byte of a generated artifact file.",
          "type": "string"
        }
      ]
    },
    "CandidateState": {
      "description": "A reader's known selection or availability state of a proven candidate.",
      "oneOf": [
        {
          "description": "The target belongs to the selected source and kind scope.",
          "properties": {
            "status": {
              "const": "selected",
              "type": "string"
            }
          },
          "required": [
            "status"
          ],
          "type": "object"
        },
        {
          "description": "The target exists outside that scope.",
          "properties": {
            "reason": {
              "$ref": "#/$defs/NotSelectedReason",
              "description": "Why it was not selected."
            },
            "status": {
              "const": "not-selected",
              "type": "string"
            }
          },
          "required": [
            "status",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "The target identity exists but its metadata is unavailable.",
          "properties": {
            "reason": {
              "$ref": "#/$defs/ReferenceUnavailable",
              "description": "Why it cannot be used."
            },
            "status": {
              "const": "unavailable",
              "type": "string"
            }
          },
          "required": [
            "status",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "ContainerIdentity": {
      "description": "A physical container Entry in the ordered path from the root Archive.",
      "properties": {
        "entry_index": {
          "description": "Zero-based directory index in the immediately enclosing Archive.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "description": "Reader-exposed display path, whose separators may already be normalised.",
          "type": "string"
        },
        "raw_path_hex": {
          "description": "Original non-UTF-8 path bytes when the display path is lossy.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "entry_index",
        "path"
      ],
      "type": "object"
    },
    "Digest": {
      "description": "An explicitly scoped integrity value.",
      "properties": {
        "algorithm": {
          "$ref": "#/$defs/Algorithm",
          "description": "Algorithm name, including the CRC polynomial where relevant."
        },
        "hex": {
          "description": "Lower-case hexadecimal spelling.",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/ByteScope",
          "description": "Exact bytes over which the value was computed or declared."
        }
      },
      "required": [
        "algorithm",
        "scope",
        "hex"
      ],
      "type": "object"
    },
    "IdentifierValue": {
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "path",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "guid",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "namespace": {
              "type": "string"
            },
            "type": {
              "const": "text",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "namespace",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "namespace": {
              "type": "string"
            },
            "type": {
              "const": "unsigned",
              "type": "string"
            },
            "value": {
              "type": "string"
            },
            "width": {
              "$ref": "#/$defs/IntegerWidth"
            }
          },
          "required": [
            "type",
            "namespace",
            "width",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "namespace": {
              "type": "string"
            },
            "type": {
              "const": "signed",
              "type": "string"
            },
            "value": {
              "type": "string"
            },
            "width": {
              "$ref": "#/$defs/IntegerWidth"
            }
          },
          "required": [
            "type",
            "namespace",
            "width",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "Identity": {
      "description": "Identity that remains distinct for duplicate names and nested containers.",
      "oneOf": [
        {
          "description": "The complete root Archive file.",
          "properties": {
            "type": {
              "const": "root",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "A physical Entry identified through each containing directory.",
          "properties": {
            "containers": {
              "description": "Ordered outermost-to-innermost physical container identities.",
              "items": {
                "$ref": "#/$defs/ContainerIdentity"
              },
              "type": "array"
            },
            "entry": {
              "$ref": "#/$defs/ContainerIdentity",
              "description": "Identity in the immediate directory."
            },
            "type": {
              "const": "entry",
              "type": "string"
            }
          },
          "required": [
            "type",
            "containers",
            "entry"
          ],
          "type": "object"
        }
      ]
    },
    "IntegerWidth": {
      "description": "Source integer width, independent of JSON or JavaScript numeric precision.",
      "oneOf": [
        {
          "const": "bits8",
          "description": "Eight source bits.",
          "type": "string"
        },
        {
          "const": "bits16",
          "description": "Sixteen source bits.",
          "type": "string"
        },
        {
          "const": "bits32",
          "description": "Thirty-two source bits.",
          "type": "string"
        },
        {
          "const": "bits64",
          "description": "Sixty-four source bits.",
          "type": "string"
        }
      ]
    },
    "MediaKind": {
      "description": "A separately selectable provider output stream.",
      "oneOf": [
        {
          "const": "archive",
          "description": "Public Archive and Entry metadata.",
          "type": "string"
        },
        {
          "const": "model",
          "description": "Model geometry and definitions.",
          "type": "string"
        },
        {
          "const": "material",
          "description": "Material definitions.",
          "type": "string"
        },
        {
          "const": "texture",
          "description": "Texture storage and images.",
          "type": "string"
        },
        {
          "const": "shader",
          "description": "Shader source or compiled data.",
          "type": "string"
        },
        {
          "const": "animation",
          "description": "Animation samples.",
          "type": "string"
        },
        {
          "const": "animation-definition",
          "description": "Animation definitions and references.",
          "type": "string"
        },
        {
          "const": "audio",
          "description": "Audio media and samples.",
          "type": "string"
        },
        {
          "const": "audio-control",
          "description": "Audio control definitions.",
          "type": "string"
        }
      ]
    },
    "NotSelectedReason": {
      "description": "Why an existing target was outside the selected projection scope.",
      "oneOf": [
        {
          "const": "filter",
          "description": "Include or exclusion Filters did not select it.",
          "type": "string"
        },
        {
          "const": "kind-not-requested",
          "description": "Its provider kind was not requested.",
          "type": "string"
        }
      ]
    },
    "OriginalIdentifier": {
      "$ref": "#/$defs/IdentifierValue",
      "description": "An unmodified source identifier with a distinct domain and integer width."
    },
    "ReferenceCandidate": {
      "description": "One actual domain-reader match, retaining order and duplicate declarations.",
      "properties": {
        "state": {
          "$ref": "#/$defs/CandidateState",
          "description": "Reader-reported selection or availability."
        },
        "target": {
          "$ref": "#/$defs/ReferenceTarget",
          "description": "Proven physical and optional subresource identity."
        }
      },
      "required": [
        "target",
        "state"
      ],
      "type": "object"
    },
    "ReferenceResolution": {
      "description": "Central reference classification, separate from source preservation and typed coverage.",
      "oneOf": [
        {
          "description": "Exactly one selected target identity was proved.",
          "properties": {
            "status": {
              "const": "resolved",
              "type": "string"
            },
            "target": {
              "$ref": "#/$defs/ReferenceTarget",
              "description": "Unique target, without claiming its projection or raw preservation complete."
            }
          },
          "required": [
            "status",
            "target"
          ],
          "type": "object"
        },
        {
          "description": "A complete lookup proved no matching target.",
          "properties": {
            "status": {
              "const": "missing",
              "type": "string"
            }
          },
          "required": [
            "status"
          ],
          "type": "object"
        },
        {
          "description": "A complete lookup proved more than one match, in original reader order.",
          "properties": {
            "candidates": {
              "description": "Every actual candidate, including duplicate declarations.",
              "items": {
                "$ref": "#/$defs/ReferenceCandidate"
              },
              "type": "array"
            },
            "status": {
              "const": "ambiguous",
              "type": "string"
            }
          },
          "required": [
            "status",
            "candidates"
          ],
          "type": "object"
        },
        {
          "description": "Exactly one target exists outside the selected projection scope.",
          "properties": {
            "reason": {
              "$ref": "#/$defs/NotSelectedReason",
              "description": "Why it was not selected."
            },
            "status": {
              "const": "not-selected",
              "type": "string"
            },
            "target": {
              "$ref": "#/$defs/ReferenceTarget",
              "description": "Proven target identity."
            }
          },
          "required": [
            "status",
            "target",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "The lookup cannot claim a complete resolution.",
          "properties": {
            "known_candidates": {
              "description": "Bounded observed candidates, without implying that this list is complete.",
              "items": {
                "$ref": "#/$defs/ReferenceCandidate"
              },
              "type": "array"
            },
            "reason": {
              "$ref": "#/$defs/ReferenceUnavailable",
              "description": "Typed reason for unavailable resolution."
            },
            "status": {
              "const": "unavailable",
              "type": "string"
            }
          },
          "required": [
            "status",
            "reason",
            "known_candidates"
          ],
          "type": "object"
        }
      ]
    },
    "ReferenceTarget": {
      "description": "A reader-proven target identity without a projection or preservation claim.",
      "properties": {
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaKind"
            },
            {
              "type": "null"
            }
          ],
          "description": "Owning provider kind for a particular metadata/subresource target."
        },
        "root": {
          "$ref": "#/$defs/Digest",
          "description": "Root Archive cryptographic identity."
        },
        "source": {
          "$ref": "#/$defs/Identity",
          "description": "Exact ordered container and physical Entry identity."
        },
        "subresource": {
          "anyOf": [
            {
              "$ref": "#/$defs/Subresource"
            },
            {
              "type": "null"
            }
          ],
          "description": "Target subresource when the reader proves one."
        }
      },
      "required": [
        "root",
        "source"
      ],
      "type": "object"
    },
    "ReferenceUnavailable": {
      "description": "Why target resolution could not establish a usable answer.",
      "oneOf": [
        {
          "description": "The target's required provider is not present.",
          "properties": {
            "type": {
              "const": "provider-missing",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Target metadata has not been read.",
          "properties": {
            "type": {
              "const": "target-not-read",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "The source identifier cannot be interpreted.",
          "properties": {
            "type": {
              "const": "invalid-identifier",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "The relevant candidate inventory is incomplete.",
          "properties": {
            "type": {
              "const": "incomplete-inventory",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "The reader does not support the reference layout.",
          "properties": {
            "type": {
              "const": "unsupported-layout",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "The target source cannot be read.",
          "properties": {
            "type": {
              "const": "source-unavailable",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Candidate enumeration exceeded its configured bound.",
          "properties": {
            "limit": {
              "description": "Candidate limit actually applied.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "candidate-limit",
              "type": "string"
            }
          },
          "required": [
            "type",
            "limit"
          ],
          "type": "object"
        },
        {
          "description": "Candidate identity metadata exceeded its configured byte bound.",
          "properties": {
            "limit": {
              "description": "Byte limit actually applied.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "candidate-bytes",
              "type": "string"
            }
          },
          "required": [
            "type",
            "limit"
          ],
          "type": "object"
        }
      ]
    },
    "Subresource": {
      "description": "Source-local identity of a metadata object or ordered subresource.",
      "properties": {
        "indices": {
          "description": "Zero-based original ordinal path, including duplicate named objects.",
          "items": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "namespace": {
          "description": "Provider-owned semantic namespace.",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "indices"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Original source identifier and an honestly bounded resolution result.",
  "properties": {
    "candidates_complete": {
      "type": "boolean"
    },
    "observed_candidates": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "original": {
      "$ref": "#/$defs/OriginalIdentifier"
    },
    "resolution": {
      "$ref": "#/$defs/ReferenceResolution"
    }
  },
  "required": [
    "original",
    "resolution",
    "observed_candidates",
    "candidates_complete"
  ],
  "title": "Reference",
  "type": "object"
}
