{
  "$defs": {
    "DecimalU64": {
      "description": "Canonical unsigned 64-bit decimal text, from 0 through 18446744073709551615.",
      "maxLength": 20,
      "not": {
        "pattern": "[^0-9]"
      },
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615)$",
      "type": "string"
    },
    "Stream": {
      "additionalProperties": false,
      "description": "Actual written byte length and SHA-256.",
      "properties": {
        "byteLength": {
          "$ref": "#/$defs/DecimalU64"
        },
        "path": {
          "const": "records.jsonl",
          "type": "string"
        },
        "rowCount": {
          "$ref": "#/$defs/DecimalU64"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "byteLength",
        "sha256",
        "rowCount"
      ],
      "type": "object"
    },
    "Totals": {
      "additionalProperties": false,
      "properties": {
        "byteLength": {
          "$ref": "#/$defs/DecimalU64"
        },
        "count": {
          "$ref": "#/$defs/DecimalU64"
        }
      },
      "required": [
        "count",
        "byteLength"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bodies": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "format": {
      "const": "p4kx-player-source-bundle",
      "type": "string"
    },
    "rawArtifacts": {
      "$ref": "#/$defs/Totals"
    },
    "records": {
      "$ref": "#/$defs/Stream"
    },
    "schemaVersion": {
      "const": 1,
      "format": "uint8",
      "maximum": 255,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "format",
    "schemaVersion",
    "bodies",
    "records",
    "rawArtifacts"
  ],
  "title": "Manifest",
  "type": "object"
}
